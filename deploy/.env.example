# deploy/.env — `cp deploy/.env.example deploy/.env` va to'ldiring. Bu fayl gitga TUSHMAYDI.

# Majburiy: uzun tasodifiy qator (masalan: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=
# Sayt manzili (vergul bilan bir nechta)
DJANGO_ALLOWED_HOSTS=teamflow.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://teamflow.example.uz
# 1 — sayt HTTPS orqali (cookie faqat HTTPS'da). Faqat ichki tarmoqdagi HTTP sinov uchun 0.
DJANGO_HTTPS=1

POSTGRES_PASSWORD=
# POSTGRES_DB=teamflow
# POSTGRES_USER=teamflow

# Telegram bot (ixtiyoriy; `--profile telegram` bilan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Resurslar — server hajmiga qarab (standart qiymatlar 2 CPU / 4 GB uchun)
# WEB_WORKERS=4          # ≈ CPU yadrolari × 2
# WEB_THREADS=4          # GIL: ko'proq oqim foyda bermaydi — jarayon qo'shing
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE=1GB
# REDIS_MAXMEMORY=256mb
# HTTP_PORT=80

# Nginx oldida yana tashqi load balancer bo'lsa: 2 (mijozning haqiqiy IP'si uchun)
# DJANGO_NUM_PROXIES=1

# So'rov chegaralari (kerak bo'lsa)
# DJANGO_THROTTLE_USER=600/min
# DJANGO_THROTTLE_AUTH_IP=60/min            # ro'yxatdan o'tish, IP bo'yicha
# DJANGO_THROTTLE_LOGIN_FAILURES_IP=1000/hour  # faqat xato loginlar, IP bo'yicha
# DJANGO_THROTTLE_LOGIN=10/min
