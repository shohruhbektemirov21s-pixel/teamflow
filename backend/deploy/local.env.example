# Namuna: `local.env` ga nusxalang (gitga tushmaydi) va ikkala sirni almashtiring.
POSTGRES_DB=teamflow
POSTGRES_PASSWORD=replace_with_random_url_safe_password
DJANGO_SECRET_KEY=replace_with_a_long_random_secret
# Kompyuter IP manzilini ham qo'shing, LAN'dan kirilsa (masalan 192.168.1.10).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8020,http://127.0.0.1:8020
# 0.0.0.0 — LAN'dagi boshqa kompyuterlar ham kiradi; faqat shu kompyuter uchun 127.0.0.1.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=8020
# HTTPS yo'q: xavfsiz cookie va HTTPS'ga yo'naltirish o'chiq.
PROXY_SCHEME=http
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
WEB_WORKERS=2
WEB_THREADS=4
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TINYFISH_API_KEY=
