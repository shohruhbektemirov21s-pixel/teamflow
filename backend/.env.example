# Mahalliy ishlab chiqish uchun 1 (SQLite va xotira keshi shu rejimda ishlaydi).
# Production'da BU QATORNI QO'SHMANG yoki 0 qiling: DATABASE_URL, REDIS_URL va DJANGO_SECRET_KEY majburiy bo'ladi.
DJANGO_DEBUG=1

# TinyFish REST API kaliti: https://agent.tinyfish.ai/api-keys
# Bu fayl namuna; haqiqiy kalitni faqat backend/.env ga yozing.
TINYFISH_API_KEY=

# Tashqi HTTP so'rovlarining soniyadagi timeout'i va faqat polling GET retry soni.
TINYFISH_TIMEOUT_SECONDS=20
TINYFISH_HTTP_RETRIES=2

